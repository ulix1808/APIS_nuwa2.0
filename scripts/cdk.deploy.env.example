# Copia a scripts/cdk.deploy.env y ajusta (no commitees secretos).
# El script scripts/cdk_deploy_hint.sh lo carga con set -a.

NUWA_CDK_ENVIRONMENT=prod
NUWA_CDK_USE_DATABASE=true
NUWA_CDK_REUSE_SECRETS=true
# FinOps: Lambdas fuera de VPC (sin Interface VPCE ~$73/mes). Ver scripts/finops_lambda_outside_vpc.sh
NUWA_LAMBDA_OUTSIDE_VPC=true
NUWA_RDS_SG_ID=sg-02664d9e7ccd46830
# Solo si NUWA_LAMBDA_OUTSIDE_VPC=false:
# NUWA_RDS_VPC_ID=vpc-0dc24fcb6dec4f5db
# NUWA_LAMBDA_SUBNET_IDS=subnet-092397141c9ed4e58,subnet-0d78b173be4b53f2d
# NUWA_LAMBDA_ROUTE_TABLE_IDS=rtb-0467093de9dda0766
NUWA_CDK_VERSION=2.170.0
CDK_DEFAULT_REGION=us-east-1
NUWA_AWS_PROFILE=nuwa-prod
